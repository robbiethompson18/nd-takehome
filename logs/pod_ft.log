$ ssh -p 18593 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR root@103.207.149.153 bash -lc 'set -e
cd /workspace/nd
echo "=== frozen Stage-1 baseline on the CURRENT heldout (2111, incl. depth>=2) ==="
python prove.py --ckpt ckpts/frozen/stage1_nope.pt --in data/heldout.jsonl --out logs/p_frozen_heldout.jsonl --greedy --max-new 220
python score_pool.py --proofs logs/p_frozen_heldout.jsonl --pool data/heldout.jsonl --label "FROZEN heldout"
for F in 0.1 0.25 0.5; do
  echo "######## extra-frac $F ########"
  python train.py --init ckpts/frozen/stage1_nope.pt --extra data/harvest/merged.jsonl --extra-frac $F \
    --lr 1e-4 --steps 400 --batch 512 --warmup 20 --eval-every 400 --eval-n 600 \
    --out ckpts/stage2_nope_f$F.pt 2>&1 | tail -12
  for POOL in rl_targets transfer; do
    python prove.py --ckpt ckpts/stage2_nope_f$F.pt --in data/long/$POOL.jsonl --out logs/p_f${F}_$POOL.jsonl --greedy --max-new 400
    python score_pool.py --proofs logs/p_f${F}_$POOL.jsonl --pool data/long/$POOL.jsonl --label "frac=$F $POOL"
  done
  python prove.py --ckpt ckpts/stage2_nope_f$F.pt --in data/heldout.jsonl --out logs/p_f${F}_heldout.jsonl --greedy --max-new 220
  python score_pool.py --proofs logs/p_f${F}_heldout.jsonl --pool data/heldout.jsonl --label "frac=$F heldout"
done'
