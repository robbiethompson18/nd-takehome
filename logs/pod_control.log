cd /workspace/nd
echo "=== CONTROL: identical fine-tune, NO harvest (isolates the nested-data confound) ==="
python train.py --init ckpts/frozen/stage1_nope.pt --lr 1e-4 --steps 400 --batch 512 --warmup 20 \
  --eval-every 400 --eval-n 600 --out ckpts/stage2_nope_noharvest.pt 2>&1 | tail -4
for POOL in rl_targets transfer; do
  python prove.py --ckpt ckpts/stage2_nope_noharvest.pt --in data/long/$POOL.jsonl --out logs/p_noharv_$POOL.jsonl --greedy --max-new 400
  python score_pool.py --proofs logs/p_noharv_$POOL.jsonl --pool data/long/$POOL.jsonl --label "NO-HARVEST $POOL"
done'
