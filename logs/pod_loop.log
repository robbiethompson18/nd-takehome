$ ssh -p 18593 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR root@103.207.149.153 bash -lc 'set -e
cd /workspace/nd
CKPT=ckpts/frozen/stage1_nope.pt
for R in 1 2 3; do
  echo "############################## ROUND $R ##############################"
  echo "--- harvest with current model ---"
  python harvest.py --ckpt $CKPT --in data/long/rl_targets.jsonl --k 32 --temperature 1.0 \
    --seed $R --batch 2048 --out data/harvest/r$R.jsonl 2>&1 | tail -5
  echo "--- FROZEN-MODEL CONTROL, same attempt budget, no retraining ---"
  python harvest.py --ckpt ckpts/frozen/stage1_nope.pt --in data/long/rl_targets.jsonl --k 32 \
    --temperature 1.0 --seed $((100+R)) --batch 2048 --out data/harvest/ctrl_r$R.jsonl 2>&1 | tail -4
  python merge_harvest.py data/harvest/nope.jsonl data/harvest/rope.jsonl data/harvest/r[1-9].jsonl --out data/harvest/all.jsonl
  echo "--- fine-tune from the FROZEN base on the cumulative harvest (STaR-style restart) ---"
  python train.py --init ckpts/frozen/stage1_nope.pt --extra data/harvest/all.jsonl --extra-frac 0.5 \
    --lr 1e-4 --steps 400 --batch 512 --warmup 20 --eval-every 400 --eval-n 600 \
    --out ckpts/stage2_r$R.pt 2>&1 | grep -E "^initialised|^3.17M|FINAL"
  CKPT=ckpts/stage2_r$R.pt
  for POOL in rl_targets transfer; do
    python prove.py --ckpt $CKPT --in data/long/$POOL.jsonl --out logs/p_r${R}_$POOL.jsonl --greedy --max-new 400 >/dev/null
    python score_pool.py --proofs logs/p_r${R}_$POOL.jsonl --pool data/long/$POOL.jsonl --label "ROUND $R $POOL"
  done
  python prove.py --ckpt $CKPT --in data/heldout.jsonl --out logs/p_r${R}_heldout.jsonl --greedy --max-new 220 >/dev/null
  python score_pool.py --proofs logs/p_r${R}_heldout.jsonl --pool data/heldout.jsonl --label "ROUND $R heldout"
done'
